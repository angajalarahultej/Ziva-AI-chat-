# ── ASTRA single env file. Copy to .env and fill keys. Never commit .env. ──

# LLM (OpenRouter-compatible, free-model friendly)
LLM_PROVIDER=openrouter
LLM_MODEL=nex-agi/nex-n2.5-mini:free
LLM_FALLBACK_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
LLM_MAX_TOKENS=300
LLM_TEMPERATURE=0.5
# Local model alternative (no key, no quota): install Ollama, run `ollama pull gemma3:4b`,
# then set LLM_PROVIDER=ollama
# LLM_PROVIDER=ollama
LLM_LOCAL_URL=http://localhost:11434
LLM_LOCAL_MODEL=gemma3:4b
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=http://localhost:5173
OPENROUTER_APP_TITLE=ASTRA

# Speech-to-text (local whisper — no key needed)
STT_PROVIDER=whisper_local
STT_MODEL_SIZE=base
STT_DEVICE=auto
# True = ~3s noise-cleaning pass (fan/bike hum). False = fastest, quiet room.
STT_DENOISE=false

# Text-to-speech (Edge-TTS — free, no key, supports te-IN + en-IN)
TTS_PROVIDER=edge
TTS_VOICE_EN=en-IN-NeerjaNeural
TTS_VOICE_TE=te-IN-ShrutiNeural
TTS_VOICE_HI=hi-IN-AnanyaNeural
TTS_RATE=+0%
TTS_VOLUME=+0%

# App
ASTRA_GREETING_EN=Good morning. I'm Ziva. I'm ready to talk.
ASTRA_GREETING_TE=నమస్తే! నేను Ziva. మాట్లాడటానికి సిద్ధంగా ఉన్నాను.
# Extra browser origins allowed to call the API (your Vercel URL), comma-separated
FRONTEND_URLS=
DEFAULT_LANGUAGE=AUTO
DATABASE_URL=sqlite:///./data/astra.db
DEBUG=false
BACKEND_PORT=8000
