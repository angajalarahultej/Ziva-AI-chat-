# Ziva backend — runs on Hugging Face Spaces (Docker, free CPU) or any host.
# Hugging Face Docker Spaces must listen on port 7860.
FROM python:3.12-slim
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg git \
  && rm -rf /var/lib/apt/lists/*
WORKDIR /srv
COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
# Bake the Whisper model into the image so cold starts don't download 500MB.
RUN python -c "from faster_whisper import WhisperModel; \
  WhisperModel('small', device='cpu', compute_type='int8')"
COPY backend/ ./backend/
# Secrets come from the platform's env vars at runtime — never bake .env in.
# Required: OPENROUTER_API_KEY, FRONTEND_URLS=https://your-app.vercel.app
# Optional: LLM_MODEL, LLM_FALLBACK_MODEL, LLM_MAX_TOKENS
EXPOSE 7860
CMD ["python", "-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", \
     "--port", "7860", "--app-dir", "backend"]
